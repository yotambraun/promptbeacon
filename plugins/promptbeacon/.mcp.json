{
  "mcpServers": {
    "promptbeacon": {
      "command": "uvx",
      "args": [
        "--from",
        "promptbeacon[mcp]>=1.4.0",
        "promptbeacon",
        "mcp"
      ],
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY:-}",
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY:-}",
        "GOOGLE_API_KEY": "${GOOGLE_API_KEY:-}",
        "GEMINI_API_KEY": "${GEMINI_API_KEY:-}",
        "MISTRAL_API_KEY": "${MISTRAL_API_KEY:-}",
        "COHERE_API_KEY": "${COHERE_API_KEY:-}",
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY:-}",
        "PROMPTBEACON_OPENAI_MODEL": "${PROMPTBEACON_OPENAI_MODEL:-}",
        "PROMPTBEACON_ANTHROPIC_MODEL": "${PROMPTBEACON_ANTHROPIC_MODEL:-}",
        "PROMPTBEACON_GOOGLE_MODEL": "${PROMPTBEACON_GOOGLE_MODEL:-}",
        "PROMPTBEACON_MISTRAL_MODEL": "${PROMPTBEACON_MISTRAL_MODEL:-}",
        "PROMPTBEACON_COHERE_MODEL": "${PROMPTBEACON_COHERE_MODEL:-}",
        "PROMPTBEACON_PERPLEXITY_MODEL": "${PROMPTBEACON_PERPLEXITY_MODEL:-}",
        "PROMPTBEACON_LITELLM_MODEL": "${PROMPTBEACON_LITELLM_MODEL:-}",
        "TAVILY_API_KEY": "${TAVILY_API_KEY:-}",
        "GITHUB_TOKEN": "${GITHUB_TOKEN:-}",
        "PROMPTBEACON_HOME": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
