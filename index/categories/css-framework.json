{
  "schema": 1,
  "id": "css-framework",
  "category": "css framework",
  "group": "Web",
  "candidates": [
    {
      "name": "Bootstrap",
      "url": "https://github.com/twbs/bootstrap",
      "match": [
        "Bootstrap"
      ],
      "case_sensitive": true
    },
    {
      "name": "Bulma",
      "url": "https://github.com/jgthms/bulma"
    },
    {
      "name": "Foundation",
      "url": "https://github.com/foundation/foundation-sites",
      "match": [
        "Foundation"
      ],
      "case_sensitive": true
    },
    {
      "name": "Pico CSS",
      "url": "https://github.com/picocss/pico",
      "match": [
        "Pico CSS",
        "Pico.css",
        "PicoCSS"
      ]
    },
    {
      "name": "Tailwind CSS",
      "url": "https://github.com/tailwindlabs/tailwindcss",
      "match": [
        "Tailwind"
      ]
    },
    {
      "name": "UnoCSS",
      "url": "https://github.com/unocss/unocss"
    }
  ],
  "prompts": [
    "What is the best css framework?",
    "Which css framework should I use for a new project?",
    "What css framework do you recommend?",
    "What are the most popular css framework options?",
    "Compare the leading css framework options.",
